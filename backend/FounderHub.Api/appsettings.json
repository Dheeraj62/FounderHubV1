{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "FounderHubDb"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS"
  },
  "AIService": {
    "BaseUrl": "http://localhost:8000",
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  }
}